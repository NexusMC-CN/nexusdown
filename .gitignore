node_modules/
dist/
*.log
.vite/
.vitest/
.worktrees/
.superpowers/
examples/**/.astro/
examples/**/.nuxt/
examples/**/.output/
docs/superpowers/
package-lock.json
!/package-lock.json
!examples/nuxt-ssr/package-lock.json

# tsup writes a bundled copy of its config next to it and normally deletes it
# again; if that cleanup is blocked (Windows AV / safe-delete shims) the file is
# left behind, so keep it out of the tree.
tsup.config.bundled_*.mjs

# CI uses npm ci with the committed root package-lock.json. Alternative
# package-manager lockfiles remain local install artefacts.
pnpm-lock.yaml
pnpm-workspace.yaml
*.tgz

# 本地诊断脚手架（光标/坐标测量台、一次性脚本），不入库
tests/_harness/

# 本地 QA 截图 / 录屏（scripts/qa-*.mjs 的产物，不入库）
.local/
