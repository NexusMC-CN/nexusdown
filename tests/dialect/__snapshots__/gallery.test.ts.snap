exports[`方言画廊 —— 渲染侧 parity > full（全功能样例） 1`] = `
"<h1>nexusdown 方言画廊</h1><p>这是 <strong>加粗</strong>、<em>斜体</em>、<em><strong>粗斜体</strong></em>、<s>删除线</s>、<code>行内代码</code>、<mark class="nd-highlight">高亮</mark> 的混排。</p><p><a target="_blank" rel="noopener noreferrer nofollow" href="https://example.com">链接</a> 和自动链接 <a target="_blank" rel="noopener noreferrer nofollow" href="https://github.com/NexusMC-CN/nexusdown">https://github.com/NexusMC-CN/nexusdown</a>。</p><blockquote><p>普通引用块。</p></blockquote><div class="nd-callout nd-callout--tip"><p class="nd-callout__title"><span class="nd-callout__icon" aria-hidden="true">✦</span><span class="nd-callout__label">提示</span></p><p>提示块（callout）也是引用块，首行是 <code>[!TYPE]</code>。</p></div><h2>列表</h2><ul><li><p>无序项</p></li><li><p>第二项</p><ul><li><p>嵌套项</p></li></ul></li></ul><ol><li><p>有序项</p></li><li><p>第二项</p></li></ol><ul data-type="taskList"><li data-checked="false" data-type="taskItem"><label><input type="checkbox"/><span/></label><div><p>待办</p></div></li><li data-checked="true" data-type="taskItem"><label><input type="checkbox" checked="checked"/><span/></label><div><p>已完成</p></div></li></ul><h2>表格</h2><table><tbody><tr><th style="text-align:left"><p>左对齐</p></th><th style="text-align:center"><p>居中</p></th><th style="text-align:right"><p>右对齐</p></th></tr><tr><td style="text-align:left"><p>1</p></td><td style="text-align:center"><p>2</p></td><td style="text-align:right"><p>3</p></td></tr><tr><td style="text-align:left"><p><mark class="nd-highlight">高亮</mark></p></td><td style="text-align:center"><p><code>code</code></p></td><td style="text-align:right"><p><strong>粗</strong></p></td></tr></tbody></table><h2>代码</h2><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#007acc" d="M23.827 8.243a4.4 4.4 0 0 1 2.223 1.281a6 6 0 0 1 .852 1.143c.011.045-1.534 1.083-2.471 1.662c-.034.023-.169-.124-.322-.35a2.01 2.01 0 0 0-1.67-1c-1.077-.074-1.771.49-1.766 1.433a1.3 1.3 0 0 0 .153.666c.237.49.677.784 2.059 1.383c2.544 1.095 3.636 1.817 4.31 2.843a5.16 5.16 0 0 1 .416 4.333a4.76 4.76 0 0 1-3.932 2.815a11 11 0 0 1-2.708-.028a6.53 6.53 0 0 1-3.616-1.884a6.3 6.3 0 0 1-.926-1.371a3 3 0 0 1 .327-.208c.158-.09.756-.434 1.32-.761l1.024-.6l.214.312a4.8 4.8 0 0 0 1.35 1.292a3.3 3.3 0 0 0 3.458-.175a1.545 1.545 0 0 0 .2-1.974c-.276-.395-.84-.727-2.443-1.422a8.8 8.8 0 0 1-3.349-2.055a4.7 4.7 0 0 1-.976-1.777a7.1 7.1 0 0 1-.062-2.268a4.33 4.33 0 0 1 3.644-3.374a9 9 0 0 1 2.691.084m-8.343 1.483l.011 1.454h-4.63v13.148H7.6V11.183H2.97V9.755a14 14 0 0 1 .04-1.466c.017-.023 2.832-.034 6.245-.028l6.211.017Z"/></svg></span></span><span class="nd-code-lang">ts</span></div><pre><code class="language-ts">export function hello(name: string) {
  return \`hello \${name}\`
}</code></pre></div><h2>数学</h2><p>行内 <code class="nd-math-source">$a^2 + b^2 = c^2$</code>，块级：</p><div class="nd-math nd-math-block"><pre class="nd-math-source">\\int_0^1 x^2 \\, dx = \\frac{1}{3}</pre></div><h2>嵌入</h2><div class="nd-embed nd-embed--bilibili" data-nd-embed="bilibili:video"><details class="nd-embed__gate"><summary class="nd-embed__placeholder"><span class="nd-embed__icon" aria-hidden="true">▶</span><span class="nd-embed__label">哔哩哔哩 · 视频 BV1xx411c7mD</span><span class="nd-embed__hint">点击加载</span></summary><iframe class="nd-embed__frame" src="//player.bilibili.com/player.html?bvid=BV1xx411c7mD&amp;autoplay=0" sandbox="allow-scripts allow-same-origin allow-popups allow-presentation" allow="fullscreen; autoplay" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></details></div><h2>变体（属性行）</h2><h3>步骤</h3><ul class="nd-steps"><li><p>准备</p></li><li><p>安装</p></li><li><p>验证</p></li></ul><h3>参数表</h3><table class="nd-fields"><caption>配置项</caption><tbody><tr><th><p>参数</p></th><th><p>类型</p></th><th><p>默认值</p></th></tr><tr><td><p>timeout</p></td><td><p>number</p></td><td><p>30</p></td></tr><tr><td><p>retries</p></td><td><p>number</p></td><td><p>3</p></td></tr></tbody></table><h3>行号与高亮</h3><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#007acc" d="M23.827 8.243a4.4 4.4 0 0 1 2.223 1.281a6 6 0 0 1 .852 1.143c.011.045-1.534 1.083-2.471 1.662c-.034.023-.169-.124-.322-.35a2.01 2.01 0 0 0-1.67-1c-1.077-.074-1.771.49-1.766 1.433a1.3 1.3 0 0 0 .153.666c.237.49.677.784 2.059 1.383c2.544 1.095 3.636 1.817 4.31 2.843a5.16 5.16 0 0 1 .416 4.333a4.76 4.76 0 0 1-3.932 2.815a11 11 0 0 1-2.708-.028a6.53 6.53 0 0 1-3.616-1.884a6.3 6.3 0 0 1-.926-1.371a3 3 0 0 1 .327-.208c.158-.09.756-.434 1.32-.761l1.024-