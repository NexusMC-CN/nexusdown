  return \`hello \${name}\`
}</code></pre></div><h2>数学</h2><p>行内 <code class="nd-math-source">$a^2 + b^2 = c^2$</code>，块级：</p><div class="nd-math nd-math-block"><pre class="nd-math-source">\\int_0^1 x^2 \\, dx = \\frac{1}{3}</pre></div><h2>嵌入</h2><div class="nd-embed nd-embed--bilibili" data-nd-embed="bilibili:video"><details class="nd-embed__gate"><summary class="nd-embed__placeholder"><span class="nd-embed__icon" aria-hidden="true">▶</span><span class="nd-embed__label">哔哩哔哩 · 视频 BV1xx411c7mD</span><span class="nd-embed__hint">点击加载</span></summary><iframe class="nd-embed__frame" src="//player.bilibili.com/player.html?bvid=BV1xx411c7mD&amp;autoplay=0" sandbox="allow-scripts allow-same-origin allow-popups allow-presentation" allow="fullscreen; autoplay" referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></details></div><h2>变体（属性行）</h2><h3>步骤</h3><ul class="nd-steps"><li><p>准备</p></li><li><p>安装</p></li><li><p>验证</p></li></ul><h3>参数表</h3><table class="nd-fields"><caption>配置项</caption><tbody><tr><th><p>参数</p></th><th><p>类型</p></th><th><p>默认值</p></th></tr><tr><td><p>timeout</p></td><td><p>number</p></td><td><p>30</p></td></tr><tr><td><p>retries</p></td><td><p>number</p></td><td><p>3</p></td></tr></tbody></table><h3>行号与高亮</h3><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#007acc" d="M23.827 8.243a4.4 4.4 0 0 1 2.223 1.281a6 6 0 0 1 .852 1.143c.011.045-1.534 1.083-2.471 1.662c-.034.023-.169-.124-.322-.35a2.01 2.01 0 0 0-1.67-1c-1.077-.074-1.771.49-1.766 1.433a1.3 1.3 0 0 0 .153.666c.237.49.677.784 2.059 1.383c2.544 1.095 3.636 1.817 4.31 2.843a5.16 5.16 0 0 1 .416 4.333a4.76 4.76 0 0 1-3.932 2.815a11 11 0 0 1-2.708-.028a6.53 6.53 0 0 1-3.616-1.884a6.3 6.3 0 0 1-.926-1.371a3 3 0 0 1 .327-.208c.158-.09.756-.434 1.32-.761l1.024-.6l.214.312a4.8 4.8 0 0 0 1.35 1.292a3.3 3.3 0 0 0 3.458-.175a1.545 1.545 0 0 0 .2-1.974c-.276-.395-.84-.727-2.443-1.422a8.8 8.8 0 0 1-3.349-2.055a4.7 4.7 0 0 1-.976-1.777a7.1 7.1 0 0 1-.062-2.268a4.33 4.33 0 0 1 3.644-3.374a9 9 0 0 1 2.691.084m-8.343 1.483l.011 1.454h-4.63v13.148H7.6V11.183H2.97V9.755a14 14 0 0 1 .04-1.466c.017-.023 2.832-.034 6.245-.028l6.211.017Z"/></svg></span></span><span class="nd-code-lang">ts</span></div><pre class="nd-code-lines"><code class="language-ts"><span class="nd-code-line">export function hi(name) {</span><span class="nd-code-line nd-code-line--hl">  return name</span><span class="nd-code-line">}</span></code></pre></div><h3>页签</h3><div class="nd-tabs"><input type="radio" name="nd-tabs-1" id="nd-tabs-1-1" checked><div class="nd-tabs__panel" data-tab="Ubuntu"><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#d9b400" d="M29.4 27.6H2.5V4.5h26.9Zm-25.9-1h24.9V5.5H3.5Z"/><path fill="#d9b400" d="m6.077 19.316l-.555-.832l4.844-3.229l-4.887-4.071l.641-.768l5.915 4.928zM12.7 18.2h7.8v1h-7.8zM2.5 5.5h26.9v1.9H2.5z"/></svg></span></span><span class="nd-code-lang">bash</span></div><pre><code class="language-bash">apt install nginx</code></pre></div></div><input type="radio" name="nd-tabs-1" id="nd-tabs-1-2"><div class="nd-tabs__panel" data-tab="macOS"><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#d9b400" d="M29.4 27.6H2.5V4.5h26.9Zm-25.9-1h24.9V5.5H3.5Z"/><path fill="#d9b400" d="m6.077 19.316l-.555-.832l4.844-3.229l-4.887-4.071l.641-.768l5.915 4.928zM12.7 18.2h7.8v1h-7.8zM2.5 5.5h26.9v1.9H2.5z"/></svg></span></span><span class="nd-code-lang">bash</span></div><pre><code class="language-bash">brew install nginx</code></pre></div></div><div class="nd-tabs__bar"><label for="nd-tabs-1-1">Ubuntu</label><label for="nd-tabs-1-2">macOS</label></div></div><h2>提及与图片</h2><p>@nexusdown 是一个 Markdown 编辑器。</p><div class="nd-carousel"><ul class="nd-carousel__track"><li class="nd-carousel__slide" id="nd-c-1-1"><img src="/img-a.svg" alt="图一"/></li><li class="nd-carousel__slide" id="nd-c-1-2"><img src="/img-b.svg" alt="图二"/></li></ul><ol class="nd-carousel__dots"><li><a class="nd-carousel__dot" href="#nd-c-1-1" aria-label="第 1 张">1</a></li><li><a class="nd-carousel__dot" href="#nd-c-1-2" aria-label="第 2 张">2</a></li></ol></div><h2>图表</h2><div class="nd-diagram"><svg xmlns="http://www.w3.org/2000/svg" class="pele pele-flowchart" viewBox="0 0 316 64" width="316" height="64" style="max-width:100%;height:auto;--_bg:var(--pele-bg,#fff);--_fg:var(--pele-fg,#1f1f1f);--_m:var(--pele-muted,#6e6e6e);--_l:var(--pele-line,#1f1f1f);--_s:var(--pele-surface,#f3f3f3);--_a:var(--pele-surface-alt,#e6e6e6);--_b:var(--pele-border,#8a8a8a);--_c:var(--pele-accent,#5b7bd5);color:var(--_fg);--_r:var(--pele-radius,4px);--_fm:var(--pele-font-mono,monospace);font:16px sans-serif;letter-spacing:normal;word-spacing:normal;text-transform:none;direction:ltr;font-family:var(--pele-font,Arial, sans-serif)" fill="var(--_fg)" role="graphics-document document" aria-roledescription="flowchart"><g class="pele-edges" fill="none" stroke="var(--_l)" stroke-linecap="round"><g class="pele-edge" data-id="L_A_B_0"><path d="M76,32L117,32"/><path class="pele-marker" d="M124,32L116,35.36L116,28.64Z" fill="var(--_l)" stroke="none"/></g><g class="pele-edge" data-id="L_B_C_0"><path d="M192,32L233,32"/><path class="pele-marker" d="M240,32L232,35.36L232,28.64Z" fill="var(--_l)" stroke="none"/></g></g><g class="pele-nodes"><g class="pele-node pele-shape-rect" data-id="A" transform="translate(42,32)"><rect x="-34" y="-24" width="68" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">编写</text></g><g class="pele-node pele-shape-rect" data-id="B" transform="translate(158,32)"><rect x="-34" y="-24" width="68" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">预览</text></g><g class="pele-node pele-shape-rect" data-id="C" transform="translate(274,32)"><rect x="-34" y="-24" width="68" height="48" fill="var(--_s)" stroke="var(--_b)" style="rx:var(--_r)"/><text class="pele-label" x="0" y="5.6" text-anchor="middle">发布</text></g></g></svg></div>"
`;

exports[`方言画廊 —— 渲染侧 parity > heading（标题） 1`] = `"<h1>一级标题</h1><h2>二级标题</h2><h3>三级标题</h3>"`;

exports[`方言画廊 —— 渲染侧 parity > highlight（==高亮==） 1`] = `"<p>这句话里有 <mark class="nd-highlight">高亮</mark> 的部分。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > image（图片） 1`] = `"<p><img src="/img-a.svg" alt="示例图"/></p>"`;

exports[`方言画廊 —— 渲染侧 parity > inline-code（行内代码） 1`] = `"<p>行内代码 <code>const answer = 42</code> 不会被当成语法。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > inline-math（行内数学 $…$） 1`] = `"<p>勾股定理：<code class="nd-math-source">$a^2 + b^2 = c^2$</code>。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > link（链接） 1`] = `"<p><a target="_blank" rel="noopener noreferrer nofollow" href="https://github.com/NexusMC-CN/nexusdown">nexusdown 仓库</a></p>"`;

exports[`方言画廊 —— 渲染侧 parity > list（列表） 1`] = `"<ul><li><p>无序项</p></li><li><p>第二项</p><ul><li><p>嵌套项</p></li></ul></li></ul><ol><li><p>有序项</p></li><li><p>第二项</p></li></ol>"`;

exports[`方言画廊 —— 渲染侧 parity > mention（提及 @slug） 1`] = `"<p>这句话里提到 @nexusdown 很好用。</p><p>@nexusdown</p>"`;

exports[`方言画廊 —— 渲染侧 parity > minimal（最小样例） 1`] = `"<h1>最小样例</h1><p>一段普通文字，带 <strong>加粗</strong> 和 <code>行内代码</code>。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > strikethrough（~~删除线~~） 1`] = `"<p>这句话里有 <s>删除线</s> 的部分。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > table-caption（参数表 + 标题） 1`] = `"<table class="nd-fields"><caption>配置项</caption><tbody><tr><th><p>参数</p></th><th><p>类型</p></th><th><p>默认值</p></th></tr><tr><td><p>timeout</p></td><td><p>number</p></td><td><p>30</p></td></tr><tr><td><p>retries</p></td><td><p>number</p></td><td><p>3</p></td></tr></tbody></table>"`;

exports[`方言画廊 —— 渲染侧 parity > table（表格） 1`] = `"<table><tbody><tr><th style="text-align:left"><p>左对齐</p></th><th style="text-align:center"><p>居中</p></th><th style="text-align:right"><p>右对齐</p></th></tr><tr><td style="text-align:left"><p>1</p></td><td style="text-align:center"><p>2</p></td><td style="text-align:right"><p>3</p></td></tr><tr><td style="text-align:left"><p><strong>粗</strong></p></td><td style="text-align:center"><p><code>code</code></p></td><td style="text-align:right"><p><mark class="nd-highlight">高亮</mark></p></td></tr></tbody></table>"`;

exports[`方言画廊 —— 渲染侧 parity > tabs（页签组（相邻围栏）） 1`] = `"<div class="nd-tabs"><input type="radio" name="nd-tabs-1" id="nd-tabs-1-1" checked><div class="nd-tabs__panel" data-tab="Ubuntu"><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#d9b400" d="M29.4 27.6H2.5V4.5h26.9Zm-25.9-1h24.9V5.5H3.5Z"/><path fill="#d9b400" d="m6.077 19.316l-.555-.832l4.844-3.229l-4.887-4.071l.641-.768l5.915 4.928zM12.7 18.2h7.8v1h-7.8zM2.5 5.5h26.9v1.9H2.5z"/></svg></span></span><span class="nd-code-lang">bash</span></div><pre><code class="language-bash">apt install nginx</code></pre></div></div><input type="radio" name="nd-tabs-1" id="nd-tabs-1-2"><div class="nd-tabs__panel" data-tab="macOS"><div class="nd-code-fence"><div class="nd-code-header" contenteditable="false"><span class="nd-code-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="nd-code-file"><span class="nd-code-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32"><path fill="#d9b400" d="M29.4 27.6H2.5V4.5h26.9Zm-25.9-1h24.9V5.5H3.5Z"/><path fill="#d9b400" d="m6.077 19.316l-.555-.832l4.844-3.229l-4.887-4.071l.641-.768l5.915 4.928zM12.7 18.2h7.8v1h-7.8zM2.5 5.5h26.9v1.9H2.5z"/></svg></span></span><span class="nd-code-lang">bash</span></div><pre><code class="language-bash">brew install nginx</code></pre></div></div><div class="nd-tabs__bar"><label for="nd-tabs-1-1">Ubuntu</label><label for="nd-tabs-1-2">macOS</label></div></div><p>尾部</p>"`;

exports[`方言画廊 —— 渲染侧 parity > task-list（任务列表） 1`] = `"<ul data-type="taskList"><li data-checked="false" data-type="taskItem"><label><input type="checkbox"/><span/></label><div><p>待办</p></div></li><li data-checked="true" data-type="taskItem"><label><input type="checkbox" checked="checked"/><span/></label><div><p>已完成</p></div></li></ul>"`;
