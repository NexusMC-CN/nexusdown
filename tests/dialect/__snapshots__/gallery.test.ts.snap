exports[`方言画廊 —— 渲染侧 parity > inline-code（行内代码） 1`] = `"<p>行内代码 <code>const answer = 42</code> 不会被当成语法。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > inline-math（行内数学 $…$） 1`] = `"<p>勾股定理：<code class="nd-math-source">$a^2 + b^2 = c^2$</code>。</p>"`;

exports[`方言画廊 —— 渲染侧 parity > link（链接） 1`] = `"<p><a target="_blank" rel="noopener noreferrer nofollow" href="https://github.com/NexusMC-CN/nexusdown">nexusdown 仓库</a></p>"`;

