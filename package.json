{
  "name": "nexusdown",
  "description": "开箱即用的 Markdown 编辑器，以及保证「编辑时看到的 = 发布出来的」的渲染器 —— 编辑器和渲染器共用同一套方言实现，不可能对不上。",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "src/render",
    "src/cm",
    "src/shared"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs"
    },
    "./cm": {
      "types": "./dist/cm/index.d.ts",
      "import": "./dist/cm/index.js",
      "require": "./dist/cm/index.cjs"
    },
    "./cm/theme.css": "./src/cm/theme.css",
    "./dialect.css": "./src/shared/dialect.css",
    "./editor": {
      "types": "./src/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./editor/style.css": "./dist/editor/nexusdown.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:consumer": "node scripts/test-consumer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup && vite build --config vite.editor.config.ts",
    "prepare": "npm run build",
    "check:exports": "node scripts/check-exports.mjs",
    "build:astro-example": "npm --prefix examples/astro-vue run build",
    "build:nuxt-example": "npm --prefix examples/nuxt-ssr run build",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:exports",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "katex": "^0.18.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/markdown": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/static-renderer": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "highlight.js": "^11.12.0",
    "iconify-icon": "^3.0.2",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "1.5.0",
    "@lezer/highlight": "1.2.1",
    "@lezer/markdown": "1.7.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "codemirror": "6.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.0",
    "vue": "^3.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
