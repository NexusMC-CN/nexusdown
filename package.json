{
  "name": "@nexusmc-cn/nexusdown",
  "description": "Markdown renderer and CodeMirror 6 editor with Vue 3 components.",
  "keywords": [
    "markdown",
    "markdown-editor",
    "markdown-renderer",
    "markdown-preview",
    "live-preview",
    "vue",
    "vue3",
    "vue-component",
    "vue-markdown",
    "codemirror",
    "codemirror6",
    "markdown-it",
    "typescript",
    "ssr",
    "nuxt",
    "astro"
  ],
  "version": "0.0.2",
  "packageManager": "pnpm@10.34.7",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusMC-CN/nexusdown.git"
  },
  "homepage": "https://github.com/NexusMC-CN/nexusdown#readme",
  "bugs": {
    "url": "https://github.com/NexusMC-CN/nexusdown/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src/editor/index.d.ts",
    "src/render",
    "src/cm",
    "src/shared"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js",
      "require": "./dist/render/index.cjs"
    },
    "./cm": {
      "types": "./dist/cm/index.d.ts",
      "import": "./dist/cm/index.js",
      "require": "./dist/cm/index.cjs"
    },
    "./cm/theme.css": "./src/cm/theme.css",
    "./dialect.css": "./src/shared/dialect.css",
    "./editor": {
      "types": "./src/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./editor/style.css": "./dist/editor/nexusdown.css"
  },
  "scripts": {
    "playground": "vite --config playground/vite.config.ts",
    "motion": "vite --config motion-lab/vite.config.ts",
    "test": "vitest run",
    "test:consumer": "node scripts/test-consumer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup && vite build --config vite.editor.config.ts",
    "prepare": "pnpm run build",
    "check:exports": "node scripts/check-exports.mjs",
    "build:vue-example": "pnpm --filter nexusdown-vue-demo run build",
    "build:astro-example": "pnpm --filter nexusdown-astro-vue-demo run build",
    "build:nuxt-example": "pnpm --filter nexusdown-nuxt-ssr-demo run build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run check:exports",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/markdown": "^1.0.0",
    "katex": "^0.18.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@lezer/markdown": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "1.5.0",
    "@lezer/highlight": "1.2.1",
    "@lezer/markdown": "1.7.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.0",
    "codemirror": "6.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "katex": "^0.19.0",
    "puppeteer-core": "^25.14.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.0",
    "vue": "^3.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
